# Copy this file to .env and fill in your own keys:   cp .env.example .env
# .env is listed in .gitignore, so your keys are never committed to GitHub.

# NASA FIRMS MAP_KEY        https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# EPA AQS (email you signed up with + key from EPA's email)
# sign up: https://aqs.epa.gov/data/api/signup?email=YOUR_EMAIL
AQS_EMAIL=
AQS_KEY=

# NOAA Climate Data Online token   https://www.ncdc.noaa.gov/cdo-web/token
NOAA_TOKEN=
